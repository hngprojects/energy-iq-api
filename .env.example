NODE_ENV=development
PORT=3330
HOST=localhost
CLIENT_URL=http://localhost:3000
ALLOWED_REDIRECT_ORIGINS=http://localhost:3000,https://app.energyiq.com # dummy

# Misc
CORS_ORIGIN=*
SWAGGER_ENABLED=true
SECRET_MANAGER_ENCRYPTION_KEY=secret_manager_encryption_key # Must be less than 32 characters for AES-256-GCM

# Chatbot
CHAT_CONTEXT_LENGTH=10
CHAT_EXP_TIMEOUT_SECONDS=3600
CHATBOT_NAME=Orochimaru

# GROQ
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=energy_iq_user
DATABASE_PASSWORD=change-me-to-a-secure-password
DATABASE_NAME=energy_iq_db
DATABASE_SYNC=false
DATABASE_LOGGING=false
DATABASE_SSL=false

# Inverter Metric

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DEFAULT_TTL=900

# Resend
RESEND_API_KEY=api_key
RESEND_FROM=energyiq@hng14.com

# OAuth (Google)
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3330/auth/google/callback

# JWT (must be at least 32 characters each)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

SOLARMAN_APP_ID=solarman_app_id
SOLARMAN_APP_SECRET=solarman_app_secret

# Sandbox mock inverter server (local dev only — run mock-inverter-server locally)
SANDBOX_API_BASE_URL=http://localhost:3002
ALLOWED_SANDBOX_TOKENS=mock-token-a,mock-token-b, mock-token-c

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=+14155238886

# BetterStack / Logtail
LOGTAIL_SOURCE_TOKEN=
LOGTAIL_INGESTING_ENDPOINT=

# Cloudinary
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_URL=
CLOUDINARY_RESOURCE_URL=
CLOUDINARY_CLOUD_NAME=

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
