<html>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <style>
      body {
        font-family: 'Trebuchet MS', 'Segoe UI', Arial, sans-serif;
      }
    </style>
  </head>
  <body
    style="margin: 0; padding: 24px 16px; background-color: #f4f5f6; font-family: 'Trebuchet MS', 'Segoe UI', Arial, sans-serif;"
  >
    <table
      border='0'
      cellpadding='0'
      cellspacing='0'
      width='100%'
      style='max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.05);'
    >
      <tr>
        <td style='padding: 30px 40px; text-align: left;'>
          <table border='0' cellpadding='0' cellspacing='0'>
            <tr>
              <td style='padding-right: 8px;'>
                <img
                  src='https://res.cloudinary.com/ds6nd4lbj/image/upload/v1778427951/logo_ej4zdv.svg'
                  alt='EnergyIQ'
                  height='32'
                  style='display: block; border: 0;'
                />
              </td>
              <td
                style='font-size: 16px; font-weight: 700; color: #111827; letter-spacing: 0.5px;'
              >
                ENERGY<span style='color: #F5A623;'>IQ</span>
              </td>
            </tr>
          </table>
        </td>
      </tr>
      <tr>
        <td style='padding: 20px 40px;'>
          <h1
            style='font-size: 28px; font-weight: bold; color: #F5A623; margin: 0 0 25px 0; text-align: center;'
          >Welcome to EnergyIQ</h1>

          <p
            style='font-size: 18px; font-weight: bold; color: #111827; margin: 0 0 10px 0;'
          >Hi {{firstName}},</p>
          <p
            style='font-size: 16px; color: #4b5563; line-height: 1.5; margin: 0 0 30px 0;'
          >
            Your account has been created successfully and your inverter is
            connected.
          </p>
          <div
            style='background-color: #f9fafb; padding: 25px; border-radius: 12px; margin-bottom: 35px;'
          >
            <table border='0' cellpadding='0' cellspacing='0' width='100%'>
              <tr>
                <td style='padding-bottom: 20px;'>
                  <span
                    style='font-weight: bold; color: #111827; display: block; font-size: 16px;'
                  >Monitor in real time</span>
                  <span style='color: #6b7280; font-size: 14px;'>Track your
                    solar generation, battery levels and energy usage.</span>
                </td>
              </tr>
              <tr>
                <td style='padding-bottom: 20px;'>
                  <span
                    style='font-weight: bold; color: #111827; display: block; font-size: 16px;'
                  >Get valuable insights</span>
                  <span style='color: #6b7280; font-size: 14px;'>Understand your
                    energy patterns and improve efficiency.</span>
                </td>
              </tr>
              <tr>
                <td>
                  <span
                    style='font-weight: bold; color: #111827; display: block; font-size: 16px;'
                  >Save more</span>
                  <span style='color: #6b7280; font-size: 14px;'>Optimize your
                    energy and reduce costs.</span>
                </td>
              </tr>
            </table>
          </div>

          <a
            href='{{clientUrl}}'
            style='background-color: #F5A623; color: #111928; padding: 18px 40px; text-decoration: none; border-radius: 8px; font-weight: bold; display: block; text-align: center; margin-bottom: 30px;
          >Log In</a>

          <p style='font-size: 14px; color: #111827; margin: 0;'>Regards,</p>
          <p
            style='font-size: 14px; color: #111827; font-weight: bold; margin: 5px 0 0 0;'
          >The EnergyIQ Team</p>
        </td>
      </tr>
      <tr>
        <td
          style='padding: 40px; background-color: #D8DBE2; text-align: center;'
        >
          <div style='margin-bottom: 12px;'>
            <img
              src='https://res.cloudinary.com/ds6nd4lbj/image/upload/v1778441114/facebook_llfkvr.svg'
              alt='Facebook'
              width='24'
              height='24'
              style='margin: 0 4px;'
            />
            <img
              src='https://res.cloudinary.com/ds6nd4lbj/image/upload/v1778441114/in_p7abpg.svg'
              alt='LinkedIn'
              width='24'
              height='24'
              style='margin: 0 4px;'
            />
            <img
              src='https://res.cloudinary.com/ds6nd4lbj/image/upload/v1778441115/x_wlwnww.svg'
              alt='X'
              width='24'
              height='24'
              style='margin: 0 4px;'
            />
            <img
              src='https://res.cloudinary.com/ds6nd4lbj/image/upload/v1778441114/discord_fcivey.svg'
              alt='Discord'
              width='24'
              height='24'
              style='margin: 0 4px;'
            />
            <img
              src='https://res.cloudinary.com/ds6nd4lbj/image/upload/v1778443756/mail-small_le1rgp.svg'
              alt='Mail'
              width='24'
              height='24'
              style='margin: 0 4px;'
            />
          </div>
          <p style='font-size: 12px; color: #6b7280; margin: 0;'>© 2025
            EnergyIQ. All rights reserved.</p>
          <p style='font-size: 12px; color: #9ca3af; margin: 5px 0 0 0;'>This is
            an automated email, please do not reply.</p>
        </td>
      </tr>
    </table>
  </body>
</html>
